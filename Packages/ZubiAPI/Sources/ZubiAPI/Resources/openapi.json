{
  "openapi": "3.1.0",
  "info": {
    "title": "Zubi API",
    "version": "1",
    "description": "The protocol between a Mac running Zubi and its clients, inside the end-to-end encrypted session each client opens through a relay; nothing reaches it any other way. It reads, creates and edits reminders, events and notes in the lists, calendars and Notes folders the Mac shares. Each one is set in Zubi's Settings to Off, Read, or Read & Write: anything Off answers 404, and writing to something shared read-only answers 403. Nothing is ever deleted. Every `/api` route needs `Authorization: Bearer <key>`, the key the client was paired with; `/api/key` tells a client which one it holds.\n\nDates are ISO 8601 in UTC, or `YYYY-MM-DD` in the Mac's time zone for all-day items.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "The Zubi serving this page"
    }
  ],
  "security": [
    {
      "bearer": []
    }
  ],
  "tags": [
    {
      "name": "Reminders"
    },
    {
      "name": "Calendar"
    },
    {
      "name": "Notes"
    },
    {
      "name": "Service"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "tags": [
          "Service"
        ],
        "summary": "Liveness check",
        "security": [],
        "responses": {
          "200": {
            "description": "Zubi is running.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "const": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/key": {
      "get": {
        "operationId": "getKey",
        "tags": [
          "Service"
        ],
        "summary": "The key you are using",
        "responses": {
          "200": {
            "description": "Its name and access.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KeyInfo"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          }
        }
      }
    },
    "/api/changes": {
      "get": {
        "operationId": "watchChanges",
        "tags": [
          "Service"
        ],
        "summary": "Be told when something changes",
        "description": "A server-sent event stream that stays open. Each message is `event: change` with a `Change` as JSON in `data`; a comment line is sent every 30 seconds to keep the connection alive. Reminders and Calendar report every change, wherever it was made. Notes has no change notifications, so only changes made through Zubi are reported for it. Messages carry no data: re-read what you show.",
        "responses": {
          "200": {
            "description": "The stream, open until the client disconnects or Zubi stops.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          }
        }
      }
    },
    "/api/lists": {
      "get": {
        "operationId": "listReminderLists",
        "tags": [
          "Reminders"
        ],
        "summary": "Exposed reminder lists",
        "responses": {
          "200": {
            "description": "Exposed lists, by account then title.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "Reminders access is not granted on the Mac.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Each list says whether it is `writable`."
      }
    },
    "/api/reminders": {
      "get": {
        "operationId": "listReminders",
        "tags": [
          "Reminders"
        ],
        "summary": "Reminders in exposed lists",
        "parameters": [
          {
            "name": "list",
            "in": "query",
            "description": "One list, by ID or title.",
            "schema": {
              "type": "string"
            },
            "example": "Groceries"
          },
          {
            "name": "due",
            "in": "query",
            "description": "`today`: incomplete and due today. `overdue`: incomplete and due before today.",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "overdue"
              ]
            },
            "example": "today"
          },
          {
            "name": "completed",
            "in": "query",
            "description": "`true` includes completed reminders. Ignored with `due`.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            },
            "example": "true"
          },
          {
            "name": "q",
            "in": "query",
            "description": "Only items whose title or notes contain this text, ignoring case.",
            "schema": {
              "type": "string"
            },
            "example": "milk"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching reminders.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RemindersResponse"
                }
              }
            }
          },
          "400": {
            "description": "`due` is neither `today` nor `overdue`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "Reminders access is not granted on the Mac.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The list is unknown or not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createReminder",
        "tags": [
          "Reminders"
        ],
        "summary": "Create a reminder",
        "requestBody": {
          "required": true,
          "description": "The new reminder.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderCreate"
              },
              "example": {
                "title": "Buy milk",
                "list": "Groceries",
                "due": "2026-11-02",
                "priority": 5
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The reminder as created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reminder"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: a missing or empty title, an unknown field, or a bad date.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The target is shared read-only, or access is not granted on the Mac. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The list is unknown or not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reminders/{id}": {
      "patch": {
        "operationId": "updateReminder",
        "tags": [
          "Reminders"
        ],
        "summary": "Edit a reminder",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The reminder's ID, from `/api/reminders`.",
            "schema": {
              "type": "string"
            },
            "example": "R2"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The fields to change.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderUpdate"
              },
              "example": {
                "isCompleted": true
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The reminder after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reminder"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: an empty title, an unknown field, or a bad date.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The reminder's list, or the list it would move to, is read-only, or access is not granted on the Mac. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The reminder is unknown, or its list is not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/calendars": {
      "get": {
        "operationId": "listCalendars",
        "tags": [
          "Calendar"
        ],
        "summary": "Exposed calendars",
        "responses": {
          "200": {
            "description": "Exposed calendars, by account then title.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CalendarsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "Calendar access is not granted on the Mac.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events": {
      "get": {
        "operationId": "listEvents",
        "tags": [
          "Calendar"
        ],
        "summary": "Events in exposed calendars",
        "description": "Recurring events come back as individual occurrences, sorted by start.",
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "description": "First day, `YYYY-MM-DD` in the Mac's time zone. Defaults to today.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-02"
          },
          {
            "name": "to",
            "in": "query",
            "description": "Last day, inclusive, `YYYY-MM-DD` in the Mac's time zone. Defaults to six days after today. At most a year after `from`.",
            "schema": {
              "type": "string",
              "format": "date"
            },
            "example": "2026-11-06"
          },
          {
            "name": "calendar",
            "in": "query",
            "description": "One calendar, by ID or title.",
            "schema": {
              "type": "string"
            },
            "example": "Work"
          },
          {
            "name": "q",
            "in": "query",
            "description": "Only items whose title or notes contain this text, ignoring case.",
            "schema": {
              "type": "string"
            },
            "example": "standup"
          }
        ],
        "responses": {
          "200": {
            "description": "Events in the range.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventsResponse"
                }
              }
            }
          },
          "400": {
            "description": "A date is malformed, `to` is before `from`, or the range exceeds a year.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "Calendar access is not granted on the Mac.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The calendar is unknown or not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createEvent",
        "tags": [
          "Calendar"
        ],
        "summary": "Create an event",
        "requestBody": {
          "required": true,
          "description": "The new event.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreate"
              },
              "example": {
                "title": "Dentist",
                "calendar": "Work",
                "start": "2026-11-03T09:00:00Z",
                "end": "2026-11-03T09:30:00Z",
                "location": "Main St 1"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The event as created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: a missing or empty title, an unknown field, a bad date, or `end` before `start`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The target is shared read-only, or access is not granted on the Mac. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The calendar is unknown or not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{id}": {
      "patch": {
        "operationId": "updateEvent",
        "tags": [
          "Calendar"
        ],
        "summary": "Edit an event",
        "description": "For a recurring event, `occurrence` picks the one occurrence to change; the rest of the series stays as it is.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The event's ID, from `/api/events`.",
            "schema": {
              "type": "string"
            },
            "example": "E1"
          },
          {
            "name": "occurrence",
            "in": "query",
            "description": "The occurrence's `start`, exactly as `/api/events` returned it. Required for a recurring event. For one that doesn't repeat it may be left out; if given, it must match the event's start.",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-02T09:00:00Z"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The fields to change.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventUpdate"
              },
              "example": {
                "title": "Standup (moved)",
                "start": "2026-11-02T09:30:00Z",
                "end": "2026-11-02T09:45:00Z"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The event, or the changed occurrence, after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed, `end` is before `start`, or the event recurs and `occurrence` is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The event's calendar, or the calendar it would move to, is read-only, or access is not granted on the Mac. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The event or occurrence is unknown, or its calendar is not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes/folders": {
      "get": {
        "operationId": "listNoteFolders",
        "tags": [
          "Notes"
        ],
        "summary": "Exposed Notes folders",
        "description": "Depth first, so a folder follows its parent.",
        "responses": {
          "200": {
            "description": "Exposed folders.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteFoldersResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "503": {
            "description": "Notes could not be read, for example because Automation access is not granted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/notes": {
      "get": {
        "operationId": "listNotes",
        "tags": [
          "Notes"
        ],
        "summary": "Note metadata, newest first",
        "parameters": [
          {
            "name": "folder",
            "in": "query",
            "description": "One folder, by ID or name.",
            "schema": {
              "type": "string"
            },
            "example": "Recipes"
          },
          {
            "name": "limit",
            "in": "query",
            "description": "At most this many notes, 1 to 500. A value outside that range is clamped to it, and a non-number is ignored, rather than rejected.",
            "schema": {
              "type": "integer",
              "default": 50
            },
            "example": 20
          },
          {
            "name": "q",
            "in": "query",
            "description": "Only notes whose title or text contains this, ignoring case. Searching text reads each note in the folder, so it can take a few seconds in a large one.",
            "schema": {
              "type": "string"
            },
            "example": "pancake"
          }
        ],
        "responses": {
          "200": {
            "description": "Notes, newest first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NoteSummariesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "404": {
            "description": "The folder is unknown or not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Notes could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createNote",
        "tags": [
          "Notes"
        ],
        "summary": "Create a note",
        "requestBody": {
          "required": true,
          "description": "The new note.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteCreate"
              },
              "example": {
                "folder": "Recipes",
                "title": "Pancakes",
                "text": "2 eggs\n250 ml milk"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The note as created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "The body is malformed: a missing or empty title, an unknown field, or both `text` and `html`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The folder is shared read-only. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The folder is unknown or not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Notes could not be written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/note": {
      "get": {
        "operationId": "getNote",
        "tags": [
          "Notes"
        ],
        "summary": "One note, with its text",
        "description": "Note IDs are `x-coredata://` URLs, so the ID travels URL-encoded in the query.",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The note's ID, from `/api/notes`.",
            "schema": {
              "type": "string"
            },
            "example": "x-coredata://00000000-0000-0000-0000-000000000000/ICNote/p1"
          }
        ],
        "responses": {
          "200": {
            "description": "The note. A locked note has no `plaintext` or `html`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "`id` is missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "404": {
            "description": "The note is unknown, or its folder is not exposed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Notes could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateNote",
        "tags": [
          "Notes"
        ],
        "summary": "Edit a note",
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The note's ID, from `/api/notes`.",
            "schema": {
              "type": "string"
            },
            "example": "x-coredata://00000000-0000-0000-0000-000000000000/ICNote/p1"
          }
        ],
        "requestBody": {
          "required": true,
          "description": "The fields to change.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NoteUpdate"
              },
              "example": {
                "text": "3 eggs\n250 ml milk"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The note after the change.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Note"
                }
              }
            }
          },
          "400": {
            "description": "`id` is missing, or the body is malformed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong API key. The body is empty."
          },
          "403": {
            "description": "The note's folder is shared read-only. Also when the request's key is read-only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The note is unknown, or its folder is not shared.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The note is locked; Zubi never changes a locked note.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Notes could not be written.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
