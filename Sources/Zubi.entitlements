<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Not sandboxed. If that changes, add com.apple.security.network.server for the HTTP API. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Under the hardened runtime, tccd refuses the Reminders and Calendar prompts without this. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Notes is read through osascript; without this every Apple event fails with -1743, unprompted. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
